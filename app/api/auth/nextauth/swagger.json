{
    "openapi": "3.0.0",
    "info": {
      "title": "API Documentation",
      "version": "1.0.0",
      "description": "API documentation for my project"
    },
    "paths": {
      "/api/hello": {
        "get": {
          "summary": "Returns a greeting",
          "responses": {
            "200": {
              "description": "A successful response",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/api/auth/signin": {
        "get": {
          "summary": "Redirects to GitHub for authentication",
          "responses": {
            "302": {
              "description": "Redirect to GitHub for authentication"
            }
          }
        }
      }
    }
  }
  